## Example usage and walkthrough for archive
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function demo_entries()
    return [
        pkg::make_text_entry("hello.txt", "Hello, Alya!"),
        pkg::make_text_entry("config/app.json", "{\"status\": \"ok\"}"),
        pkg::make_dir_entry("assets")
    ]
end

@cfg(feature = "tar")
function demo_tar()
    let entries = demo_entries()
    # ───────────────────────────────────────────────────────────
    # 2. TAR Round-Trip
    # ───────────────────────────────────────────────────────────
    say "--- 2. TAR Round-Trip ---"
    let tar_img = pkg::pack(entries, pkg::ArchiveFormat.Tar)
    say "Tar image bytes: " + str(len(tar_img))
    say "Detected:        " + pkg::format_name(pkg::detect_format(tar_img))
    let tar_back = pkg::unpack(tar_img)
    for e in tar_back
        say "  - " + e.name + " (" + str(pkg::entry_size(e)) + " bytes)"
    end
    say ""
end

@cfg(not(feature = "tar"))
function demo_tar()
end

@cfg(feature = "zip")
function demo_zip()
    let entries = demo_entries()
    # ───────────────────────────────────────────────────────────
    # 3. ZIP Round-Trip
    # ───────────────────────────────────────────────────────────
    say "--- 3. ZIP Round-Trip ---"
    let zip_img = pkg::pack(entries, pkg::ArchiveFormat.Zip)
    say "Zip image bytes: " + str(len(zip_img))
    say "Detected:        " + pkg::format_name(pkg::detect_format(zip_img))
    say "Listed:          " + str(len(pkg::list_names(zip_img))) + " entries"
    let first = pkg::find_entry(pkg::unpack(zip_img), "hello.txt")
    say "Extracted:       " + pkg::entry_text(first)
    say ""
end

@cfg(not(feature = "zip"))
function demo_zip()
end

@cfg(feature = "targz")
function demo_targz()
    let entries = demo_entries()
    # ───────────────────────────────────────────────────────────
    # 4. TAR.GZ Round-Trip
    # ───────────────────────────────────────────────────────────
    say "--- 4. TAR.GZ Round-Trip ---"
    let tgz_img = pkg::targz_pack(entries)
    say "Tarball bytes: " + str(len(tgz_img))
    say "Detected:      " + pkg::format_name(pkg::detect_format(tgz_img))
    say "Unpacked:      " + str(len(pkg::targz_unpack(tgz_img))) + " entries"
    say ""
end

@cfg(not(feature = "targz"))
function demo_targz()
end

@cfg(feature = "io")
@cfg(feature = "zip")
function demo_files()
    let entries = demo_entries()
    # ───────────────────────────────────────────────────────────
    # 5. File Persistence
    # ───────────────────────────────────────────────────────────
    say "--- 5. File Persistence ---"
    pkg::pack_file("./demo_archive.zip", entries, pkg::ArchiveFormat.Zip)
    let loaded = pkg::unpack_file("./demo_archive.zip")
    say "Reloaded entries: " + str(len(loaded))
    remove_file("./demo_archive.zip")
    say ""
end

@cfg(any(not(feature = "io"), not(feature = "zip")))
function demo_files()
end

function main()
    say "=== archive Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Build An Entry Set
    # ───────────────────────────────────────────────────────────
    say "--- 1. Entry Set ---"
    let entries = demo_entries()
    say "Entries: " + str(len(entries))

    demo_tar()
    demo_zip()
    demo_targz()
    demo_files()

    say "Done!"
end

main()
