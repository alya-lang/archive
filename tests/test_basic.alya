## Test suite for archive
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("archive Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Entry Models & Constructors
    # ═══════════════════════════════════════════════════════════
    let e = pkg::make_entry("hello.txt", [72, 105])
    runner_assert_str_eq(r, e.name, "hello.txt", "entry name is stored")
    runner_assert_eq(r, pkg::entry_size(e), 2, "entry_size reports payload length")
    runner_assert_eq(r, e.mode, 420, "entry mode defaults to 420 (0644)")
    runner_assert_eq(r, e.mtime, 0, "entry mtime defaults to 0")
    runner_assert_eq(r, pkg::entry_is_dir(e), 0, "file entry is not a dir")

    let d = pkg::make_dir_entry("assets")
    runner_assert_str_eq(r, d.name, "assets/", "dir entry gains trailing slash")
    runner_assert_eq(r, pkg::entry_is_dir(d), 1, "dir entry flag is set")
    runner_assert_eq(r, d.mode, 493, "dir mode defaults to 493 (0755)")

    let t = pkg::make_text_entry("note.txt", "Hello, Alya!")
    runner_assert_str_eq(r, pkg::entry_text(t), "Hello, Alya!", "text entry round-trips through bytes")

    runner_assert_str_eq(r, pkg::format_name(pkg::ArchiveFormat.Tar), "tar", "format_name Tar")
    runner_assert_str_eq(r, pkg::format_name(pkg::ArchiveFormat.Zip), "zip", "format_name Zip")
    runner_assert_str_eq(r, pkg::format_name(pkg::ArchiveFormat.TarGz), "tar.gz", "format_name TarGz")
    runner_assert_str_eq(r, pkg::format_name(pkg::ArchiveFormat.SevenZ), "7z", "format_name SevenZ")
    runner_assert_str_eq(r, pkg::format_name(pkg::ArchiveFormat.Rar), "rar", "format_name Rar")
    runner_assert_str_eq(r, pkg::format_name(pkg::ArchiveFormat.Unknown), "unknown", "format_name Unknown")

    runner_assert_eq(r, pkg::ZipMethod.Stored, 0, "ZipMethod.Stored == 0")
    runner_assert_eq(r, pkg::ZipMethod.Deflated, 8, "ZipMethod.Deflated == 8")

    # ═══════════════════════════════════════════════════════════
    # 2. CRC-32 Integrity
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::archive_crc32([]), 0, "crc of empty input is 0")
    runner_assert_eq(r, pkg::archive_crc32([49, 50, 51, 52, 53, 54, 55, 56, 57]), 3421780262, "crc32 of '123456789' matches IEEE vector")
    runner_assert_eq(r, pkg::archive_crc32([0]), 3523407757, "crc32 of single zero byte matches vector")

    # ═══════════════════════════════════════════════════════════
    # 3. Byte / Octal Codec Round-Trips
    # ═══════════════════════════════════════════════════════════
    let u16_buf = [0, 0, 0, 0]
    pkg::put_u16le(u16_buf, 1, 22561)
    runner_assert_eq(r, pkg::get_u16le(u16_buf, 1), 22561, "u16 little-endian round-trip")

    let u32_buf = [0, 0, 0, 0, 0, 0]
    pkg::put_u32le(u32_buf, 2, 3421780262)
    runner_assert_eq(r, pkg::get_u32le(u32_buf, 2), 3421780262, "u32 little-endian round-trip")

    let oct = pkg::int_to_octal(420, 7)
    runner_assert_eq(r, pkg::octal_to_int(oct), 420, "octal codec round-trips 420")
    runner_assert_eq(r, pkg::octal_to_int(pkg::int_to_octal(1234567890, 11)), 1234567890, "octal codec round-trips mtime value")
    runner_assert_eq(r, bytes_equal([1, 2, 3], [1, 2, 3]), true, "bytes_equal accepts identical arrays")
    runner_assert_eq(r, bytes_equal([1, 2, 3], [1, 2, 4]), false, "bytes_equal rejects differing arrays")
    runner_assert_eq(r, bytes_equal([1, 2], [1, 2, 3]), false, "bytes_equal rejects length mismatch")

    # ═══════════════════════════════════════════════════════════
    # 4. Format Detection
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::detect_format([80, 75, 3, 4, 20, 0]), pkg::ArchiveFormat.Zip, "PK signature detects Zip")
    runner_assert_eq(r, pkg::detect_format([31, 139, 8, 0, 0]), pkg::ArchiveFormat.TarGz, "gzip magic detects TarGz")
    runner_assert_eq(r, pkg::detect_format([55, 122, 188, 175, 39, 28, 0]), pkg::ArchiveFormat.SevenZ, "7z magic detects SevenZ")
    runner_assert_eq(r, pkg::detect_format([82, 97, 114, 33, 26, 7]), pkg::ArchiveFormat.Rar, "Rar! magic detects Rar")
    runner_assert_eq(r, pkg::detect_format([1, 2, 3]), pkg::ArchiveFormat.Unknown, "random bytes detect Unknown")
    runner_assert_eq(r, pkg::detect_format([]), pkg::ArchiveFormat.Unknown, "empty input detects Unknown")

    # ═══════════════════════════════════════════════════════════
    # 5. TAR Build / Parse Round-Trip
    # ═══════════════════════════════════════════════════════════
    let big = []
    let bi = 0
    while bi < 600
        big.push(bi % 251)
        bi += 1
    end
    let tar_entries = [
        pkg::make_text_entry("hello.txt", "Hello, Alya!", 420, 1234567890),
        pkg::make_entry("empty.bin"),
        pkg::make_entry("data/blob.bin", big, 384, 1234567890),
        pkg::make_dir_entry("assets")
    ]
    let tar_img = pkg::tar_build(tar_entries)
    runner_assert_eq(r, pkg::detect_format(tar_img), pkg::ArchiveFormat.Tar, "built tar image detects as Tar")

    let expected_len = 1024
    for te in tar_entries
        expected_len += 512
        if te.is_dir == 0
            expected_len += ((len(te.data) + 511) / 512) * 512
        end
    end
    runner_assert_eq(r, len(tar_img), expected_len, "tar image length matches header + padded payloads + trailer")

    let tar_back = pkg::tar_parse(tar_img)
    runner_assert_eq(r, len(tar_back), 4, "tar parse returns all entries")
    runner_assert_str_eq(r, tar_back[0].name, "hello.txt", "tar entry 0 name preserved")
    runner_assert_str_eq(r, pkg::entry_text(tar_back[0]), "Hello, Alya!", "tar entry 0 text preserved")
    runner_assert_eq(r, tar_back[0].mode, 420, "tar entry 0 mode preserved")
    runner_assert_eq(r, tar_back[0].mtime, 1234567890, "tar entry 0 mtime preserved")
    runner_assert_eq(r, len(tar_back[1].data), 0, "tar empty entry stays empty")
    runner_assert_eq(r, bytes_equal(tar_back[2].data, big), true, "tar binary payload with NUL bytes round-trips")
    runner_assert_eq(r, tar_back[2].mode, 384, "tar custom mode 0600 preserved")
    runner_assert_eq(r, pkg::entry_is_dir(tar_back[3]), 1, "tar dir entry flag preserved")

    let tar_listed = pkg::tar_names(tar_img)
    runner_assert_eq(r, len(tar_listed), 4, "tar_names lists every entry")
    runner_assert_str_eq(r, tar_listed[2], "data/blob.bin", "tar_names keeps nested path")

    # ═══════════════════════════════════════════════════════════
    # 6. ZIP Stored Build / Parse Round-Trip
    # ═══════════════════════════════════════════════════════════
    let zip_bin = [0, 1, 2, 0, 255, 0, 65, 66, 0, 128]
    let zip_entries = [
        pkg::make_text_entry("hello.txt", "Hello, Alya!"),
        pkg::make_entry("empty.bin"),
        pkg::make_entry("data/blob.bin", zip_bin, 384, 0),
        pkg::make_dir_entry("assets")
    ]
    let zip_img = pkg::zip_build(zip_entries, 0)
    runner_assert_eq(r, pkg::detect_format(zip_img), pkg::ArchiveFormat.Zip, "built zip image detects as Zip")

    let zip_back = pkg::zip_parse(zip_img)
    runner_assert_eq(r, len(zip_back), 4, "zip parse returns all entries")
    runner_assert_str_eq(r, pkg::entry_text(zip_back[0]), "Hello, Alya!", "zip entry 0 text preserved")
    runner_assert_eq(r, bytes_equal(zip_back[2].data, zip_bin), true, "zip binary payload with NUL bytes round-trips")
    runner_assert_eq(r, zip_back[2].mode, 384, "zip custom mode preserved via external attributes")
    runner_assert_eq(r, pkg::entry_is_dir(zip_back[3]), 1, "zip dir entry flag preserved")

    let found = pkg::find_entry(zip_back, "data/blob.bin")
    runner_assert_eq(r, found is null, false, "find_entry locates stored entry")
    runner_assert_eq(r, pkg::find_entry(zip_back, "missing.txt") is null, true, "find_entry returns null when absent")

    # ═══════════════════════════════════════════════════════════
    # 7. Unified Facade Dispatch
    # ═══════════════════════════════════════════════════════════
    let packed_tar = pkg::pack(tar_entries, pkg::ArchiveFormat.Tar)
    runner_assert_eq(r, bytes_equal(packed_tar, tar_img), true, "pack(Tar) matches tar_build output")
    let unpacked_auto = pkg::unpack(packed_tar)
    runner_assert_eq(r, len(unpacked_auto), 4, "unpack auto-detects tar image")
    let unpacked_zip = pkg::unpack(zip_img, pkg::ArchiveFormat.Zip)
    runner_assert_eq(r, len(unpacked_zip), 4, "unpack with explicit Zip format works")
    let facade_names = pkg::list_names(zip_img)
    runner_assert_str_eq(r, facade_names[0], "hello.txt", "list_names auto-detects and lists zip")
    runner_assert_str_eq(r, pkg::list_names(packed_tar)[3], "assets/", "list_names covers tar dir entry")

    # ═══════════════════════════════════════════════════════════
    # 8. Binary-Safe File Persistence
    # ═══════════════════════════════════════════════════════════
    let raw_path = "./target_test_archive_raw.bin"
    pkg::save_archive(raw_path, zip_bin)
    let raw_back = pkg::load_archive(raw_path)
    runner_assert_eq(r, bytes_equal(raw_back, zip_bin), true, "raw bytes with NUL survive file round-trip")
    remove_file(raw_path)

    let tar_path = "./target_test_archive.tar"
    pkg::pack_file(tar_path, tar_entries, pkg::ArchiveFormat.Tar)
    let tar_file_back = pkg::unpack_file(tar_path)
    runner_assert_eq(r, len(tar_file_back), 4, "tar pack_file/unpack_file round-trips")
    runner_assert_eq(r, bytes_equal(tar_file_back[2].data, big), true, "tar file round-trip preserves binary payload")
    remove_file(tar_path)

    let zip_path = "./target_test_archive.zip"
    pkg::pack_file(zip_path, zip_entries, pkg::ArchiveFormat.Zip)
    let zip_file_back = pkg::unpack_file(zip_path)
    runner_assert_eq(r, len(zip_file_back), 4, "zip pack_file/unpack_file round-trips")
    runner_assert_eq(r, bytes_equal(zip_file_back[2].data, zip_bin), true, "zip file round-trip preserves binary payload")
    remove_file(zip_path)

    # ═══════════════════════════════════════════════════════════
    # 9. Compressed Containers (via compress codecs)
    # ═══════════════════════════════════════════════════════════
    let zip_deflated = pkg::zip_build(zip_entries, 8)
    runner_assert_eq(r, pkg::detect_format(zip_deflated), pkg::ArchiveFormat.Zip, "deflated zip still detects as Zip")
    let zip_inflated = pkg::zip_parse(zip_deflated)
    runner_assert_eq(r, len(zip_inflated), 4, "deflated zip parse returns all entries")
    runner_assert_eq(r, bytes_equal(zip_inflated[2].data, zip_bin), true, "deflated zip payload inflates exactly")
    runner_assert_str_eq(r, pkg::entry_text(zip_inflated[0]), "Hello, Alya!", "deflated zip text inflates exactly")

    let tgz_img = pkg::targz_pack(tar_entries)
    runner_assert_eq(r, pkg::detect_format(tgz_img), pkg::ArchiveFormat.TarGz, "packed tarball detects as TarGz")
    let tgz_back = pkg::targz_unpack(tgz_img)
    runner_assert_eq(r, len(tgz_back), 4, "tarball unpack returns all entries")
    runner_assert_eq(r, bytes_equal(tgz_back[2].data, big), true, "tarball round-trip preserves binary payload")
    let tgz_auto = pkg::unpack(tgz_img)
    runner_assert_str_eq(r, tgz_auto[0].name, "hello.txt", "unpack auto-detects TarGz image")

    let tgz_path = "./target_test_archive.tgz"
    pkg::pack_file(tgz_path, tar_entries, pkg::ArchiveFormat.TarGz)
    let tgz_file_back = pkg::unpack_file(tgz_path)
    runner_assert_eq(r, len(tgz_file_back), 4, "tarball pack_file/unpack_file round-trips")
    remove_file(tgz_path)

    # ═══════════════════════════════════════════════════════════
    # 10. Repeated Builds Over Shared Entries (alya#125 regression)
    # ═══════════════════════════════════════════════════════════
    # Borrowed payload arrays once lost their GC root when returned
    # through a helper call, corrupting rebuild loops. Hammer the same
    # shared entries: every image must stay byte-identical.
    let shared_entries = [
        pkg::make_text_entry("hello.txt", "Hello, Alya!"),
        pkg::make_entry("data/blob.bin", zip_bin)
    ]
    let first_zip = pkg::zip_build(shared_entries, 0)
    let zip_stable = true
    let rz = 0
    while rz < 100
        if len(pkg::zip_build(shared_entries, 0)) != len(first_zip)
            zip_stable = false
        end
        rz += 1
    end
    runner_assert_eq(r, zip_stable, true, "100 repeated stored zip_builds stay identical")

    let first_def = pkg::zip_build(shared_entries, 8)
    let def_stable = true
    let rd = 0
    while rd < 50
        if len(pkg::zip_build(shared_entries, 8)) != len(first_def)
            def_stable = false
        end
        rd += 1
    end
    runner_assert_eq(r, def_stable, true, "50 repeated deflated zip_builds stay identical")

    let loop_parsed = pkg::zip_parse(pkg::zip_build(shared_entries, 0))
    runner_assert_eq(r, bytes_equal(loop_parsed[1].data, zip_bin), true, "looped rebuild preserves binary payload")

    let first_tar = pkg::tar_build(tar_entries)
    let tar_stable = true
    let rt = 0
    while rt < 50
        if len(pkg::tar_build(tar_entries)) != len(first_tar)
            tar_stable = false
        end
        rt += 1
    end
    runner_assert_eq(r, tar_stable, true, "50 repeated tar_builds stay identical")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
