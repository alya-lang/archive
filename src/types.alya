## Archive Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Container format identifiers, ZIP method codes, and the shared entry
## model used by the TAR, ZIP, and TAR.GZ engines.

import "std/str"

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Public enumeration of supported (and explicitly detected but
## unsupported) archive container formats.
##
## - `Unknown`: Unrecognized byte stream, no known magic signature.
## - `Tar`: POSIX ustar (`tar`) archive.
## - `Zip`: ZIP container (stored and deflated entries).
## - `TarGz`: Gzip-compressed tarball (`.tar.gz` / `.tgz`).
## - `SevenZ`: Detected 7z signature (read/write unsupported in v0.1.0).
## - `Rar`: Detected RAR signature (unsupported, proprietary format).
pub enum ArchiveFormat
    Unknown = 0,
    Tar = 1,
    Zip = 2,
    TarGz = 3,
    SevenZ = 4,
    Rar = 5
end

## Public enumeration of ZIP compression methods (subset).
##
## - `Stored`: No compression, raw payload bytes (`0`).
## - `Deflated`: Raw DEFLATE stream via `compress` codecs (`8`).
pub enum ZipMethod
    Stored = 0,
    Deflated = 8
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Archive entry model: a single named file or directory payload.
##
## Payloads are plain byte arrays (`array` of `0..255` ints), never
## strings, so embedded NUL bytes round-trip safely through every engine.
##
## ### Fields
## - `name`: Entry path inside the archive (POSIX separators).
## - `data`: Raw payload bytes (empty for directories).
## - `mode`: POSIX permission bits (e.g. `420` for `0644`).
## - `mtime`: Modification time as Unix epoch seconds (`0` when unknown).
## - `is_dir`: Directory flag (`1` for directories, `0` for files).
pub struct ArchiveEntry
    name: string,
    data: array,
    mode: int,
    mtime: int,
    is_dir: int
end

# ───────────────────────────────────────────────────────────────
# Public Factory Constructors
# ───────────────────────────────────────────────────────────────

## Factory constructor creating a file `ArchiveEntry` from raw bytes.
##
## ### Parameters
## - `name`: Entry path inside the archive.
## - `data`: Raw payload byte array. Defaults to `[]`.
## - `mode`: POSIX permission bits. Defaults to `420` (`0644`).
## - `mtime`: Modification epoch seconds. Defaults to `0`.
##
## ### Returns
## A fully initialized file `ArchiveEntry`.
##
## ### Examples
## ```alya
## let e = make_entry("hello.txt", [72, 105])
## ```
pub function make_entry(name: string, data: array = [], mode: int = 420, mtime: int = 0) -> ArchiveEntry
    return ArchiveEntry {
        name: name,
        data: data,
        mode: mode,
        mtime: mtime,
        is_dir: 0
    }
end

## Factory constructor creating a directory `ArchiveEntry`.
##
## A trailing slash is appended when missing, following tar/zip convention.
##
## ### Parameters
## - `name`: Directory path inside the archive.
## - `mode`: POSIX permission bits. Defaults to `493` (`0755`).
## - `mtime`: Modification epoch seconds. Defaults to `0`.
##
## ### Returns
## A directory `ArchiveEntry` with an empty payload.
pub function make_dir_entry(name: string, mode: int = 493, mtime: int = 0) -> ArchiveEntry
    let dir_name = name
    if ends_with(dir_name, "/") == 0
        dir_name += "/"
    end
    return ArchiveEntry {
        name: dir_name,
        data: [],
        mode: mode,
        mtime: mtime,
        is_dir: 1
    }
end

## Returns the payload size of an entry in bytes.
##
## ### Parameters
## - `entry`: The target `ArchiveEntry` instance.
##
## ### Returns
## Payload byte count (`0` for directories).
pub function entry_size(entry: ArchiveEntry) -> int
    return len(entry.data)
end

## Returns 1 when the entry is a directory, 0 otherwise.
##
## ### Parameters
## - `entry`: The target `ArchiveEntry` instance.
##
## ### Returns
## The entry `is_dir` flag.
pub function entry_is_dir(entry: ArchiveEntry) -> int
    return entry.is_dir
end

## Returns the canonical lowercase name of an archive format.
##
## ### Parameters
## - `format`: An `ArchiveFormat` value.
##
## ### Returns
## `"tar"`, `"zip"`, `"tar.gz"`, `"7z"`, `"rar"`, or `"unknown"`.
pub function format_name(format: int) -> string
    return when format
        is ArchiveFormat.Tar => "tar"
        is ArchiveFormat.Zip => "zip"
        is ArchiveFormat.TarGz => "tar.gz"
        is ArchiveFormat.SevenZ => "7z"
        is ArchiveFormat.Rar => "rar"
        else => "unknown"
    end
end
