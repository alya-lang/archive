## Archive Byte-Level Utilities
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Little-endian codecs, ustar octal field helpers, string conversion, and
## buffer primitives shared by the TAR and ZIP engines. Generic byte
## comparison and string encoding reuse `std/str` (`bytes_equal`,
## `bytes_from_string`); only the inverse conversion lives here because the
## standard library offers no NUL-free `bytes_to_string` equivalent.

import "std/str"

# ───────────────────────────────────────────────────────────────
# Buffer Primitives
# ───────────────────────────────────────────────────────────────

## Returns a zero-filled byte array of the requested length.
##
## ### Parameters
## - `count`: Number of zero bytes to allocate.
##
## ### Returns
## Array of `count` zero bytes.
pub function bytes_zero(count: int) -> array
    let out = []
    let i = 0
    while i < count
        out.push(0)
        i += 1
    end
    return out
end

## Appends all bytes of `src` to `buf` in place.
##
## ### Parameters
## - `buf`: Destination byte array (mutated).
## - `src`: Source byte array.
pub function bytes_append(buf, src)
    for b in src
        buf.push(b)
    end
end

## Concatenates two byte arrays into a new array.
##
## ### Parameters
## - `a`: Leading byte array.
## - `b`: Trailing byte array.
##
## ### Returns
## New array holding a copy of `a` followed by a copy of `b`.
pub function bytes_concat(a, b) -> array
    let out = []
    for v in a
        out.push(v)
    end
    for v in b
        out.push(v)
    end
    return out
end

## Extracts a sub-range of bytes into a new array.
##
## ### Parameters
## - `src`: Source byte array.
## - `start`: Zero-based start offset.
## - `count`: Number of bytes to copy.
##
## ### Returns
## New array of `count` bytes starting at `start`.
pub function bytes_slice(src, start: int, count: int) -> array
    let out = []
    let i = 0
    while i < count
        out.push(src[start + i])
        i += 1
    end
    return out
end

## Copies `src` bytes into `buf` at the given offset.
##
## ### Parameters
## - `buf`: Destination byte array (mutated).
## - `offset`: Zero-based destination offset.
## - `src`: Source byte array.
pub function poke_bytes(buf, offset: int, src)
    let i = 0
    while i < len(src)
        buf[offset + i] = src[i]
        i += 1
    end
end

## Returns true when the inspected range holds only zero bytes.
##
## ### Parameters
## - `block`: Source byte array.
## - `offset`: Zero-based start offset.
## - `size`: Number of bytes to inspect.
##
## ### Returns
## `true` when every inspected byte is zero, `false` otherwise.
pub function is_zero_block(block, offset: int, size: int) -> bool
    let i = 0
    while i < size
        if block[offset + i] != 0
            return false
        end
        i += 1
    end
    return true
end

# ───────────────────────────────────────────────────────────────
# Little-Endian Integer Codecs
# ───────────────────────────────────────────────────────────────

## Writes a 16-bit value to `buf` in little-endian order.
##
## ### Parameters
## - `buf`: Destination byte array (mutated).
## - `offset`: Zero-based destination offset.
## - `value`: Integer value (`0..65535`).
pub function put_u16le(buf, offset: int, value: int)
    buf[offset] = bit_and(value, 255)
    buf[offset + 1] = bit_and(bit_shr(value, 8), 255)
end

## Writes a 32-bit value to `buf` in little-endian order.
##
## ### Parameters
## - `buf`: Destination byte array (mutated).
## - `offset`: Zero-based destination offset.
## - `value`: Integer value (`0..4294967295`).
pub function put_u32le(buf, offset: int, value: int)
    buf[offset] = bit_and(value, 255)
    buf[offset + 1] = bit_and(bit_shr(value, 8), 255)
    buf[offset + 2] = bit_and(bit_shr(value, 16), 255)
    buf[offset + 3] = bit_and(bit_shr(value, 24), 255)
end

## Reads a 16-bit little-endian value from `buf`.
##
## ### Parameters
## - `buf`: Source byte array.
## - `offset`: Zero-based start offset.
##
## ### Returns
## Integer value (`0..65535`).
pub function get_u16le(buf, offset: int) -> int
    return bit_or(buf[offset], bit_shl(buf[offset + 1], 8))
end

## Reads a 32-bit little-endian value from `buf`.
##
## ### Parameters
## - `buf`: Source byte array.
## - `offset`: Zero-based start offset.
##
## ### Returns
## Integer value (`0..4294967295`).
pub function get_u32le(buf, offset: int) -> int
    let lo = bit_or(buf[offset], bit_shl(buf[offset + 1], 8))
    let hi = bit_or(buf[offset + 2], bit_shl(buf[offset + 3], 8))
    return bit_or(lo, bit_shl(hi, 16))
end

# ───────────────────────────────────────────────────────────────
# Ustar Octal Field Codecs
# ───────────────────────────────────────────────────────────────

## Parses a NUL/space-padded octal byte field into an integer.
##
## ### Parameters
## - `field`: Raw field bytes (digits with NUL/space padding).
##
## ### Returns
## Parsed integer value.
pub function octal_to_int(field) -> int
    let value = 0
    for b in field
        if b != 0 and b != 32
            value = value * 8 + (b - 48)
        end
    end
    return value
end

## Encodes an integer as zero-padded octal digit bytes (no terminator).
##
## ### Parameters
## - `value`: Integer value to encode.
## - `digits`: Exact number of digit bytes to emit.
##
## ### Returns
## Array of `digits` ASCII octal digit bytes.
pub function int_to_octal(value: int, digits: int) -> array
    let reversed = []
    let v = value
    if v == 0
        reversed.push(48)
    end
    while v > 0
        reversed.push(48 + (v % 8))
        v /= 8
    end
    let out = []
    let pad = digits - len(reversed)
    let i = 0
    while i < pad
        out.push(48)
        i += 1
    end
    let j = len(reversed) - 1
    while j >= 0
        out.push(reversed[j])
        j -= 1
    end
    return out
end

# ───────────────────────────────────────────────────────────────
# String Field Codecs
# ───────────────────────────────────────────────────────────────

## Writes a string into a fixed-width NUL-padded field of a header buffer.
##
## ### Parameters
## - `header`: Destination byte array (mutated, pre-zeroed).
## - `offset`: Zero-based destination offset.
## - `text`: ASCII text to store (v0.1.0 entry names are ASCII).
## - `max_len`: Field capacity in bytes (content must fit).
pub function write_str_field(header, offset: int, text: string, max_len: int)
    let nb = bytes_from_string(text)
    if len(nb) > max_len
        throw "archive: text field exceeds capacity of " + str(max_len) + " bytes"
    end
    poke_bytes(header, offset, nb)
end

## Reads a NUL-terminated string from a fixed-width header field.
##
## ### Parameters
## - `block`: Source byte array.
## - `offset`: Zero-based start offset.
## - `max_len`: Field capacity in bytes.
##
## ### Returns
## Decoded text up to the first NUL byte.
pub function read_str_field(block, offset: int, max_len: int) -> string
    let out = []
    let i = 0
    let done = 0
    while i < max_len
        if done == 0
            let b = block[offset + i]
            if b == 0
                done = 1
            else
                out.push(b)
            end
        end
        i += 1
    end
    return bytes_to_string(out)
end

# ───────────────────────────────────────────────────────────────
# Byte/String Conversion (NUL-Free Text Only)
# ───────────────────────────────────────────────────────────────

# String-to-bytes conversion reuses `std/str` `bytes_from_string`
# (imported above); entry names are ASCII in v0.1.0, for which the
# conversion is byte-exact.

## Converts a byte array into a string (NUL-free payloads only).
##
## Byte arrays holding embedded NUL bytes cannot survive as Alya strings
## (`len` / `write_file` treat strings as NUL-terminated), so callers must
## only convert text payloads known to be NUL-free.
##
## ### Parameters
## - `bytes`: Array of byte integers.
##
## ### Returns
## Decoded string.
pub function bytes_to_string(bytes) -> string
    let n = len(bytes)
    if n == 0
        return ""
    end
    let p = alloc(n + 1)
    let i = 0
    while i < n
        poke_byte(p, i, bytes[i])
        i += 1
    end
    poke_byte(p, n, 0)
    let s = str_clone(str_from_ptr(p))
    free(p)
    return s
end
