## Archive Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Serves as the primary public entry point for the archive package,
## exposing format detection, unified pack/unpack dispatch, text helpers,
## and binary-safe file persistence.

import "./types.alya"
import "./core/bytes.alya"
# file.alya stays unconditional: the zip/targz backends need its codec
# helpers (archive_crc32, inflate_exact, gunzip_exact). Only the
# file-persistence facades further below are gated on `io`.
import "./core/file.alya"
@cfg(feature = "tar")
import "./core/tar.alya"
@cfg(feature = "zip")
import "./core/zip.alya"
@cfg(feature = "targz")
import "./core/codecs.alya"

# ───────────────────────────────────────────────────────────────
# Feature-Sliced Pack / Unpack Backends
# ───────────────────────────────────────────────────────────────
# The unified pack/unpack dispatch below must link in every feature
# view, so each backend goes through a thin wrapper with a throwing
# fallback stub (template pattern) instead of shrinking away.

@cfg(feature = "tar")
function pack_tar(entries) -> array
    return tar_build(entries)
end

@cfg(not(feature = "tar"))
function pack_tar(entries) -> array
    throw "tar feature is disabled (rebuild with default features or --features tar)"
end

@cfg(feature = "tar")
function unpack_tar(data) -> array
    return tar_parse(data)
end

@cfg(not(feature = "tar"))
function unpack_tar(data) -> array
    throw "tar feature is disabled (rebuild with default features or --features tar)"
end

@cfg(feature = "zip")
function pack_zip(entries) -> array
    return zip_build(entries, 0)
end

@cfg(not(feature = "zip"))
function pack_zip(entries) -> array
    throw "zip feature is disabled (rebuild with default features or --features zip)"
end

@cfg(feature = "zip")
function unpack_zip(data) -> array
    return zip_parse(data)
end

@cfg(not(feature = "zip"))
function unpack_zip(data) -> array
    throw "zip feature is disabled (rebuild with default features or --features zip)"
end

@cfg(feature = "targz")
function pack_tgz(entries) -> array
    return targz_pack(entries)
end

@cfg(not(feature = "targz"))
function pack_tgz(entries) -> array
    throw "targz feature is disabled (rebuild with default features or --features targz)"
end

@cfg(feature = "targz")
function unpack_tgz(data) -> array
    return targz_unpack(data)
end

@cfg(not(feature = "targz"))
function unpack_tgz(data) -> array
    throw "targz feature is disabled (rebuild with default features or --features targz)"
end

# ───────────────────────────────────────────────────────────────
# Format Detection
# ───────────────────────────────────────────────────────────────

## Detects the archive container format from magic signature bytes.
##
## Recognizes ZIP (`PK\x03\x04`), gzip (tarball), 7z, RAR, and ustar
## (`ustar` at offset 257) images. Anything else is `Unknown`.
##
## ### Parameters
## - `data`: Archive image byte array.
##
## ### Returns
## An `ArchiveFormat` value.
##
## ### Examples
## ```alya
## let fmt = detect_format(zip_bytes) # ArchiveFormat.Zip
## ```
pub function detect_format(data) -> int
    let n = len(data)
    if n >= 4 and data[0] == 80 and data[1] == 75 and data[2] == 3 and data[3] == 4
        return ArchiveFormat.Zip
    end
    if n >= 6 and data[0] == 55 and data[1] == 122 and data[2] == 188 and data[3] == 175 and data[4] == 39 and data[5] == 28
        return ArchiveFormat.SevenZ
    end
    if n >= 4 and data[0] == 82 and data[1] == 97 and data[2] == 114 and data[3] == 33
        return ArchiveFormat.Rar
    end
    if n >= 3 and data[0] == 31 and data[1] == 139 and data[2] == 8
        return ArchiveFormat.TarGz
    end
    if n >= 262 and data[257] == 117 and data[258] == 115 and data[259] == 116 and data[260] == 97 and data[261] == 114
        return ArchiveFormat.Tar
    end
    return ArchiveFormat.Unknown
end

# ───────────────────────────────────────────────────────────────
# Unified Pack / Unpack Dispatch
# ───────────────────────────────────────────────────────────────

## Packs entries into the requested container format.
##
## ### Parameters
## - `entries`: Array of `ArchiveEntry` structs to store.
## - `format`: An `ArchiveFormat` value. Defaults to `ArchiveFormat.Zip`.
##
## ### Returns
## Archive image as a byte array, or throws for unsupported formats.
pub function pack(entries, format: int = 2) -> array
    when format
        is ArchiveFormat.Tar then return pack_tar(entries)
        is ArchiveFormat.Zip then return pack_zip(entries)
        is ArchiveFormat.TarGz then return pack_tgz(entries)
        is ArchiveFormat.SevenZ then throw "archive: 7z packing is unsupported in v0.1.0 (roadmap)"
        is ArchiveFormat.Rar then throw "archive: rar packing is unsupported (proprietary format)"
        else throw "archive: unknown archive format: " + str(format)
    end
end

## Unpacks an archive image back into entry records.
##
## ### Parameters
## - `data`: Archive image byte array.
## - `format`: An `ArchiveFormat` value, or `-1` to auto-detect.
##
## ### Returns
## Array of `ArchiveEntry` structs, or throws for unsupported formats.
pub function unpack(data, format: int = -1) -> array
    let fmt = format
    if fmt == -1
        fmt = detect_format(data)
    end
    when fmt
        is ArchiveFormat.Tar then return unpack_tar(data)
        is ArchiveFormat.Zip then return unpack_zip(data)
        is ArchiveFormat.TarGz then return unpack_tgz(data)
        is ArchiveFormat.SevenZ then throw "archive: 7z unpacking is unsupported in v0.1.0 (roadmap)"
        is ArchiveFormat.Rar then throw "archive: rar unpacking is unsupported (proprietary format)"
        else throw "archive: unknown archive format: " + str(fmt)
    end
end

## Lists entry names of an archive image without copying payloads.
##
## ### Parameters
## - `data`: Archive image byte array.
## - `format`: An `ArchiveFormat` value, or `-1` to auto-detect.
##
## ### Returns
## Array of entry name strings in archive order.
pub function list_names(data, format: int = -1) -> array
    let parsed = unpack(data, format)
    let names = []
    for e in parsed
        names.push(e.name)
    end
    return names
end

# ───────────────────────────────────────────────────────────────
# Text Entry Helpers
# ───────────────────────────────────────────────────────────────

## Builds a file entry from a UTF-8 text string (NUL-free text only).
##
## ### Parameters
## - `name`: Entry path inside the archive.
## - `text`: UTF-8 payload text without embedded NUL bytes.
## - `mode`: POSIX permission bits. Defaults to `420` (`0644`).
## - `mtime`: Modification epoch seconds. Defaults to `0`.
##
## ### Returns
## A file `ArchiveEntry` with the encoded payload.
pub function make_text_entry(name: string, text: string, mode: int = 420, mtime: int = 0) -> ArchiveEntry
    return make_entry(name, bytes_from_string(text), mode, mtime)
end

## Decodes an entry payload back into text (NUL-free payloads only).
##
## ### Parameters
## - `entry`: The target `ArchiveEntry` instance.
##
## ### Returns
## Decoded payload string.
pub function entry_text(entry: ArchiveEntry) -> string
    return bytes_to_string(entry.data)
end

## Finds the first entry with the given name, or null when absent.
##
## ### Parameters
## - `entries`: Array of `ArchiveEntry` structs to search.
## - `name`: Entry path to look up.
##
## ### Returns
## The matching `ArchiveEntry`, or null.
pub function find_entry(entries, name: string)
    for e in entries
        if e.name == name
            return e
        end
    end
    return null
end

# ───────────────────────────────────────────────────────────────
# Binary-Safe File Persistence
# ───────────────────────────────────────────────────────────────

## Saves an archive image to disk without text mangling.
##
## ### Parameters
## - `path`: Destination file path (overwritten).
## - `data`: Archive image byte array.
##
## ### Returns
## `1` on success, or throws an error.
##
## Requires the `io` feature (default-on).
@cfg(feature = "io")
pub function save_archive(path: string, data) -> int
    return save_bytes(path, data)
end

## Loads an archive image from disk, preserving every byte.
##
## ### Parameters
## - `path`: Source file path.
##
## ### Returns
## Archive image byte array, or throws an error.
##
## Requires the `io` feature (default-on).
@cfg(feature = "io")
pub function load_archive(path: string) -> array
    return load_bytes(path)
end

## Packs entries and writes the image directly to disk.
##
## ### Parameters
## - `path`: Destination file path (overwritten).
## - `entries`: Array of `ArchiveEntry` structs to store.
## - `format`: An `ArchiveFormat` value. Defaults to `ArchiveFormat.Zip`.
##
## ### Returns
## `1` on success, or throws an error.
##
## Requires the `io` feature (default-on).
@cfg(feature = "io")
pub function pack_file(path: string, entries, format: int = 2) -> int
    return save_archive(path, pack(entries, format))
end

## Loads an archive image from disk and unpacks it.
##
## ### Parameters
## - `path`: Source file path.
## - `format`: An `ArchiveFormat` value, or `-1` to auto-detect.
##
## ### Returns
## Array of `ArchiveEntry` structs, or throws on corrupt input.
##
## Requires the `io` feature (default-on).
@cfg(feature = "io")
pub function unpack_file(path: string, format: int = -1) -> array
    return unpack(load_archive(path), format)
end
